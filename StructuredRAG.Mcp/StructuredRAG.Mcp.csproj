<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StructuredRAG.Core\StructuredRAG.Core.csproj" />
    <ProjectReference Include="..\StructuredRAG.Fhnw\StructuredRAG.Fhnw.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Widget templates served via resources/read, plus the shared design tokens and
         host bridge they pull in through {{include:...}} (see Resources/WidgetResources.cs) -->
    <EmbeddedResource Include="Widgets\*.html" />
    <EmbeddedResource Include="Widgets\_tokens.css" />
    <EmbeddedResource Include="Widgets\_host.js" />
  </ItemGroup>

</Project>
