# Environment Variables for Structured RAG
# Copy this file to .env and update with your values
# IMPORTANT: Never commit .env to source control

# SQL Server Configuration
SA_PASSWORD=YourStrong@Passw0rd
MSSQL_PID=Developer

# Database Connection String
CONNECTION_STRING=Server=sqlserver;Database=StructuredRAG;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;MultipleActiveResultSets=true

# Gemma LLM Configuration
GEMMA_ENDPOINT=http://gemma:11434/api/generate
